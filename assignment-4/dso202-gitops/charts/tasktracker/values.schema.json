{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasktracker values (DSO202 Assignment 4)",
  "description": "Checked by helm lint, helm template and by Argo CD when it renders the chart. Same schema as Assignment 3, changed for GitOps: environments are dev and staging, credentials only by existingSecret, env maps per tier, floating tags rejected.",
  "type": "object",
  "required": ["environment", "images", "credentials", "database", "backend", "frontend", "progressDeadlineSeconds"],
  "properties": {
    "environment": { "enum": ["", "dev", "staging"] },
    "images": {
      "type": "object",
      "required": ["pullPolicy", "frontend", "backend", "database"],
      "properties": {
        "pullPolicy": { "enum": ["IfNotPresent", "Never"] },
        "frontend": { "$ref": "#/$defs/image" },
        "backend":  { "$ref": "#/$defs/image" },
        "database": { "$ref": "#/$defs/image" }
      }
    },
    "credentials": {
      "type": "object",
      "required": ["existingSecret"],
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" }
      }
    },
    "database": {
      "type": "object",
      "required": ["name", "port", "persistence", "resources"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "env":  { "$ref": "#/$defs/env" },
        "persistence": {
          "type": "object",
          "required": ["size"],
          "properties": {
            "size":         { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
            "storageClass": { "type": "string" }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "backend": {
      "type": "object",
      "required": ["replicaCount", "port", "corsOrigin", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 5 },
        "port":         { "type": "integer", "minimum": 1, "maximum": 65535 },
        "corsOrigin":   { "type": "string", "minLength": 1 },
        "env":          { "$ref": "#/$defs/env" },
        "resources":    { "$ref": "#/$defs/resources" }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["replicaCount", "port", "service", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 5 },
        "port":         { "type": "integer", "minimum": 1, "maximum": 65535 },
        "env":          { "$ref": "#/$defs/env" },
        "service": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type":     { "const": "NodePort" },
            "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
          }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "progressDeadlineSeconds": { "type": "integer", "minimum": 30 },
    "nameOverride":     { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "enum": ["latest", "stable", "master", "HEAD"] } }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits":   { "type": "object", "required": ["cpu", "memory"] }
      }
    }
  }
}
